# === Database ===
DATABASE_URL="postgresql://hotel:hotel_dev_2026@localhost:5432/hotel_management"

# === Redis ===
REDIS_URL="redis://default:hotel_redis_2026@localhost:6379"

# === JWT ===
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# === Super Admin 2FA (Email OTP) — v9 SaaS Control Room ===
# Pepper for the HMAC-SHA256 digest of OTP codes and signer for the short-lived
# `sa_otp` challenge cookie. MUST be ≥32 chars and unique in production.
# See docs/SUPER-ADMIN-ARCH.md §8.
SUPERADMIN_OTP_SECRET="change-me-superadmin-otp-min-32-chars"
SUPERADMIN_OTP_TTL_SECONDS="600"
SUPERADMIN_OTP_MAX_ATTEMPTS="5"
SUPERADMIN_OTP_RESEND_COOLDOWN_SECONDS="60"

# === Crypto (Integration key encryption) — v8 Decoupled PMS Ledger ===
# 64 hex chars = 32 bytes. Encrypts per-hotel IntegrationConfig apiKeyEnc
# (external booking-engine API keys). Required since v8 — outbound gateways removed.
PAYMENT_CRYPTO_KEY="change-me-64-hex-characters"

# === Email (Resend) ===
RESEND_API_KEY="re_..."

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
