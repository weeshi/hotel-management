generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  الفندق — الإعدادات الأساسية
// ============================================================
model Hotel {
  id           String   @id @default(uuid())
  name         String
  nameAr       String?
  customDomain String?  @unique
  address      String?
  phone        String?
  email        String?
  currency     String   @default("LYD")
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("12:00")
  timezone     String   @default("Asia/Tripoli")
  settings     String?
  createdAt    DateTime @default(now())

  rooms                 Room[]
  roomTypes             RoomType[]
  ratePlans             RatePlan[]
  cancellationPolicies  CancellationPolicy[]
  services              Service[]
  serviceCategories     ServiceCategory[]
  bookings              Booking[]
  users                 User[]
  guests                Guest[]
  apiPartners           ApiPartner[]
  taxRules              TaxRule[]
  housekeepingTasks     HousekeepingTask[]
  taskTypes             TaskType[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  menuCategories        MenuCategory[]
  menuItems             MenuItem[]
  restaurantOrders      RestaurantOrder[]
  safeDepositBoxes      SafeDepositBox[]
  safeboxPackages       SafeBoxPackage[]
  externalClients       ExternalClient[]
  lostItems             LostItem[]
  reportSetting         ReportSetting?
  websiteSetting        WebsiteSetting?
  groupBookings         GroupBooking[]
  invitations           Invitation[]
  payments              Payment[]
  integrationConfigs    IntegrationConfig[]
  gatewayWebhooks       GatewayWebhook[]
  paymentSessions       PaymentSession[]
  apiKeys               ApiKey[]
  channelMappings       ChannelMapping[]
  channelPriceSnapshots ChannelPriceSnapshot[]
  vccAuditLogs          VCCAuditLog[]
  folios                Folio[]
  folioTransactions     FolioTransaction[]
  folioDiscounts        FolioDiscount[]
  scheduledCharges      ScheduledCharge[]
  roomCharges           RoomCharge[]
  bookingRooms          BookingRoom[]
  bookingServices       BookingService[]
  guestDocuments        GuestDocument[]
  folioRoutingRules     FolioRoutingRule[]
  invoices              Invoice[]
  refunds               Refund[]
  restaurantOrderItems  RestaurantOrderItem[]
  roomTypeAmenities     RoomTypeAmenity[]
  roomTypeDefaultServices RoomTypeDefaultService[]
  roomTypeExtraBeds     RoomTypeExtraBed[]
  safeBoxTransactions   SafeBoxTransaction[]
  safeDepositBoxItems   SafeDepositBoxItem[]
  walletTransactions    WalletTransaction[]
  webhookEndpoints      WebhookEndpoint[]
}

// ============================================================
//  المستخدمون والصلاحيات
// ============================================================
enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTION
  MANAGER
  HOUSEKEEPING
  MAINTENANCE
  RESTAURANT
  ACCOUNTANT
}

// --- Headless API consumers (PartnerType for ApiKey) ---
// HOTEL_SITE: the hotel's own website booking engine
// B2C_AGGREGATOR: a central booking platform/portal
// B2B_AGENCY: a travel agency partner
// CHANNEL_MANAGER: an OTA / channel manager (future OTA module)
enum PartnerType {
  HOTEL_SITE
  B2C_AGGREGATOR
  B2B_AGENCY
  CHANNEL_MANAGER
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  password            String
  name                String
  phone               String?
  role                Role            @default(RECEPTION)
  hotelId             String?
  hotel               Hotel?          @relation(fields: [hotelId], references: [id])
  isActive            Boolean         @default(true)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean         @default(false)
  twoFactorMethod     TwoFactorMethod @default(NONE)
  lastTwoFactorAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  refreshTokens       RefreshToken[]
  otpChallenges       OtpChallenge[]
  createdAt           DateTime        @default(now())

  createdTransactions FolioTransaction[]   @relation("TransactionCreatedBy")
  settledFolios       Folio[]              @relation("FolioSettledBy")
  openedSafeDeposits  SafeDepositBox[]     @relation("SafeDepositOpenedBy")
  closedSafeDeposits  SafeDepositBox[]     @relation("SafeDepositClosedBy")
  foundLostItems      LostItem[]           @relation("LostItemFoundBy")
  safeBoxTransactions SafeBoxTransaction[]
  walletTransactions  WalletTransaction[]
  uploadedDocuments   GuestDocument[]      @relation("GuestDocumentUploadedBy")
  createdInvitations  Invitation[]         @relation("InvitationCreatedBy")
  apiKeysCreated      ApiKey[]             @relation("ApiKeyCreatedBy")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  expiresAt  DateTime
  family     String
  revoked    Boolean  @default(false)
  replacedBy String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
//  المصادقة الثنائية لمالك المنصة (Super Admin 2FA · Email OTP)
// ============================================================
// See docs/SUPER-ADMIN-ARCH.md. The OTP code is NEVER stored in plaintext:
// only an HMAC-SHA256 digest (keyed by SUPERADMIN_OTP_SECRET, bound to the
// userId + purpose) is persisted. Challenges are single-use and short-lived.
enum TwoFactorMethod {
  NONE
  EMAIL_OTP
  TOTP
}

enum OtpPurpose {
  SUPER_ADMIN_LOGIN
  SUPER_ADMIN_STEP_UP
}

model OtpChallenge {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  purpose     OtpPurpose @default(SUPER_ADMIN_LOGIN)
  codeHash    String
  sentTo      String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt     DateTime?
  lastCodeSentAt DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime   @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// ============================================================
//  سجل تدقيق المنصة (Platform Audit) — مستقل عن AuditLog المستأجَر
// ============================================================
// Tenant AuditLog requires a hotelId. Platform-wide actions (OTP lifecycle,
// super-admin key management for a hotel) have no single tenant, so they are
// recorded here. Secrets and OTP codes are NEVER written to this ledger.
model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entity      String
  entityId    String?
  hotelId     String?
  oldValue    String?
  newValue    String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entity, entityId])
}

// ============================================================
//  دعوات إنشاء الحسابات (SaaS Onboarding)
// ============================================================
model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  email       String
  name        String?
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  role        Role      @default(MANAGER)
  createdById String?
  createdBy   User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([hotelId])
  @@index([email])
  @@index([expiresAt])
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  MOBICASH
  SADAD
  TADAWUL
  PLUTU
  TLYNC
  BANK_TRANSFER
  IDFA3LY
  YASERPAY
  ONEPAY
  CASH
  CARD
  POS
  WALLET
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  REFUND_FROM_FOLIO
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ============================================================
//  الضيوف
// ============================================================
model Guest {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  name          String
  email         String?
  phone         String?
  address       String?
  nationality   String?
  idNumber      String?
  idDocumentUrl String?
  emailVerified Boolean  @default(false)
  loyaltyPoints Int      @default(0)
  allowCredit   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  bookings        Booking[]
  wallets         Wallet[]
  paymentSessions PaymentSession[]
  documents       GuestDocument[]

  @@unique([hotelId, email])
  @@unique([hotelId, phone])
  @@unique([hotelId, idNumber])
  @@index([hotelId])
}

// ============================================================
//  وثائق الضيوف (خاصة - لا تُخزن في المجلد العام)
// ============================================================
model GuestDocument {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id])
  documentType String
  fileName     String
  fileMimeType String
  storagePath  String
  uploadedAt   DateTime @default(now())
  uploadedById String
  uploadedBy   User     @relation("GuestDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([guestId])
  @@index([uploadedById])
}

model Wallet {
  id        String   @id @default(uuid())
  guestId   String
  hotelId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  balance   Decimal  @default(0)
  isFrozen  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@unique([guestId, hotelId])
  @@index([hotelId])
}

model WalletTransaction {
  id             String                @id @default(uuid())
  hotelId        String
  hotel          Hotel                 @relation(fields: [hotelId], references: [id])
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id])
  type           WalletTransactionType
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  description    String?
  referenceId    String?
  idempotencyKey String?               @unique
  method         PaymentMethod?
  status         TransactionStatus     @default(COMPLETED)
  createdById    String?
  createdBy      User?                 @relation(fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())

  @@index([walletId])
  @@index([createdAt])
}

// ============================================================
//  الغرف وأنواعها
// ============================================================
model RoomType {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  name         String
  nameAr       String?
  description  String?
  baseRate     Float
  capacity     Int      @default(2)
  images       String?
  isWebVisible Boolean  @default(true)
  webRoomLimit Int?
  webPrice     Float?
  createdAt    DateTime @default(now())

  rooms           Room[]
  ratePlans       RatePlan[]
  extraBeds       RoomTypeExtraBed[]
  defaultServices RoomTypeDefaultService[]
  amenityServices RoomTypeAmenity[]
  bookingRooms    BookingRoom[]
  channelMappings ChannelMapping[]
  priceSnapshots  ChannelPriceSnapshot[]
}

model RoomTypeExtraBed {
  id         String   @id @default(uuid())
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  bedType    String
  label      String
  labelAr    String?
  price      Float
  maxCount   Int      @default(1)

  @@index([roomTypeId])
}

model RoomTypeDefaultService {
  id         String   @id @default(uuid())
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  isFree     Boolean  @default(true)

  @@unique([roomTypeId, serviceId])
  @@index([roomTypeId])
}

model RoomTypeAmenity {
  id         String   @id @default(uuid())
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([roomTypeId, serviceId])
  @@index([roomTypeId])
}

model Room {
  id                 String   @id @default(uuid())
  hotelId            String
  hotel              Hotel    @relation(fields: [hotelId], references: [id])
  roomNumber         String
  floor              Int?
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id])
  status             String   @default("AVAILABLE")
  housekeepingStatus String   @default("CLEAN")
  notes              String?
  createdAt          DateTime @default(now())

  bookingRooms      BookingRoom[]
  housekeepingTasks HousekeepingTask[]
  safeDepositBoxes  SafeDepositBox[]
  lostItems         LostItem[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
}

// ============================================================
//  الأسعار الموسمية (Rate Plans)
// ============================================================
model RatePlan {
  id                   String              @id @default(uuid())
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id])
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id])
  name                 String
  nameAr               String?
  nightlyRate          Float
  startDate            DateTime
  endDate              DateTime
  minStay              Int                 @default(1)
  maxAdults            Int                 @default(2)
  maxChildren          Int                 @default(0)
  extraBedPrice        Float?
  applyDays            String?
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())

  bookingRooms    BookingRoom[]
  channelMappings ChannelMapping[]

  @@index([hotelId, roomTypeId])
}

model CancellationPolicy {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  rules     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ratePlans RatePlan[]
  bookings  Booking[]

  @@index([hotelId])
}

// ============================================================
//  عدّادات الأرقام المتسلسلة (Atomic Sequences)
// ============================================================
model BookingNumberCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
//  الحجوزات
// ============================================================
model Booking {
  id                   String              @id @default(uuid())
  bookingNo            String              @unique
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id])
  guestId              String?
  guest                Guest?              @relation(fields: [guestId], references: [id])
  guestName            String?
  guestEmail           String?
  guestPhone           String?
  status               String              @default("PENDING")
  source               String              @default("WEBSITE")
  adults               Int                 @default(1)
  children             Int                 @default(0)
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  cancelledAt          DateTime?
  cancellationReason   String?
  groupBookingId       String?
  groupBooking         GroupBooking?       @relation(fields: [groupBookingId], references: [id])
  externalRef          String?
  webTaxAmount         Float               @default(0)
  webFeesAmount        Float               @default(0)
  webDiscountAmount    Float               @default(0)
  webTotalAmount       Float               @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  rooms            BookingRoom[]
  folio            Folio?
  bookingServices  BookingService[]
  payments         Payment[]
  paymentSessions  PaymentSession[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  restaurantOrders RestaurantOrder[]
  safeDepositBoxes SafeDepositBox[]

  @@unique([hotelId, externalRef])
  @@index([hotelId, status, createdAt])
  @@index([groupBookingId])
}

model BookingRoom {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id])
  roomTypeId  String?
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id])
  ratePlanId  String?
  ratePlan    RatePlan? @relation(fields: [ratePlanId], references: [id])
  nightlyRate Float
  checkIn     DateTime
  checkOut    DateTime

  roomCharges RoomCharge[]

  @@index([bookingId])
  @@index([roomId])
  @@index([roomTypeId])
}

// ============================================================
//  الخدمات
// ============================================================
model ServiceCategory {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  services Service[]

  @@index([hotelId])
}

model Service {
  id               String          @id @default(uuid())
  hotelId          String
  hotel            Hotel           @relation(fields: [hotelId], references: [id])
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  name             String
  nameAr           String?
  description      String?
  price            Float
  capacityIncrease Int             @default(0)
  taxRuleId        String?
  taxRule          TaxRule?        @relation(fields: [taxRuleId], references: [id])
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())

  bookingServices   BookingService[]
  roomTypeDefaults  RoomTypeDefaultService[]
  roomTypeAmenities RoomTypeAmenity[]

  @@index([hotelId, categoryId])
}

model BookingService {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ============================================================
//  الحجوزات الجماعية والمجموعات
// ============================================================
model GroupBooking {
  id            String    @id @default(uuid())
  name          String
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  companyName   String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  checkIn       DateTime?
  checkOut      DateTime?
  status        String    @default("ACTIVE")
  notes         String?
  masterFolioId String?   @unique
  masterFolio   Folio?    @relation("MasterFolio", fields: [masterFolioId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings     Booking[]
  routingRules FolioRoutingRule[]

  @@index([hotelId])
}

model FolioRoutingRule {
  id             String       @id @default(uuid())
  hotelId        String
  hotel          Hotel        @relation(fields: [hotelId], references: [id])
  groupBookingId String
  groupBooking   GroupBooking @relation(fields: [groupBookingId], references: [id])
  chargeType     String
  targetFolioId  String
  targetFolio    Folio        @relation(fields: [targetFolioId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([groupBookingId, chargeType])
  @@index([groupBookingId])
}

// ============================================================
//  نظام الفوترة (Folio Billing)
// ============================================================
model Folio {
  id           String    @id @default(uuid())
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id])
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id])
  status       String    @default("ACTIVE")
  totalCharges Float     @default(0)
  totalPaid    Float     @default(0)
  balance      Float     @default(0)
  settledAt    DateTime?
  settledById  String?
  settledBy    User?     @relation("FolioSettledBy", fields: [settledById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions       FolioTransaction[]
  payments           Payment[]
  paymentSessions    PaymentSession[]
  invoices           Invoice[]
  discounts          FolioDiscount[]
  scheduledCharges   ScheduledCharge[]
  groupBookingMaster GroupBooking?      @relation("MasterFolio")
  routingRuleTargets FolioRoutingRule[]

  @@index([bookingId])
  @@index([hotelId])
  @@index([status])
}

model ScheduledCharge {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  folioId     String
  folio       Folio     @relation(fields: [folioId], references: [id])
  description String
  amount      Float
  chargeDate  DateTime
  processed   Boolean   @default(false)
  processedAt DateTime?

  @@index([folioId, chargeDate])
  @@index([hotelId])
}

model RoomCharge {
  id              String      @id @default(uuid())
  hotelId         String
  hotel           Hotel       @relation(fields: [hotelId], references: [id])
  bookingRoomId   String
  bookingRoom     BookingRoom @relation(fields: [bookingRoomId], references: [id])
  date            DateTime
  amount          Float
  taxAmount       Float       @default(0)
  status          String      @default("PENDING")
  postedToFolioAt DateTime?

  folioTransaction FolioTransaction?

  @@index([bookingRoomId, date])
  @@index([hotelId])
}

model FolioTransaction {
  id            String      @id @default(uuid())
  hotelId       String
  hotel         Hotel       @relation(fields: [hotelId], references: [id])
  folioId       String
  folio         Folio       @relation(fields: [folioId], references: [id])
  type          String
  category      String
  description   String
  amount        Float
  taxAmount     Float       @default(0)
  taxableAmount Float       @default(0)
  isPartial     Boolean     @default(false)
  referenceId   String?
  roomChargeId  String?     @unique
  roomCharge    RoomCharge? @relation(fields: [roomChargeId], references: [id])
  createdById   String?
  createdBy     User?       @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([folioId])
  @@index([createdAt])
  @@index([hotelId])
}

model FolioDiscount {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  folioId     String
  folio       Folio    @relation(fields: [folioId], references: [id])
  type        String
  value       Float
  amount      Float
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([folioId])
  @@index([hotelId])
}

// ============================================================
//  المدفوعات
// ============================================================
model Payment {
  id               String   @id @default(uuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id])
  bookingId        String?
  booking          Booking? @relation(fields: [bookingId], references: [id])
  folioId          String?
  folio            Folio?   @relation(fields: [folioId], references: [id])
  amount           Float
  currency         String   @default("LYD")
  method           String
  gateway          String?
  gatewayPaymentId String?
  gatewayIntentId  String?
  idempotencyKey   String?  @unique
  externalRef      String?
  metadata         String?
  refundedAmount   Float    @default(0)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  // VGS / VCC fields (PCI-DSS compliant — no PAN/CVV stored)
  vccToken       String? // Tokenized card number (e.g., tok_visa_...)
  vccExpiryToken String? // Tokenized expiry date
  vccCVVToken    String? // Tokenized CVV
  vccProvider    String? // Tokenization provider (e.g., 'vgs')
  vgsVaultId     String? // VGS Vault ID reference
  vccHolderName  String? // Cardholder name (non-sensitive)
  vccPurgedAt    DateTime? // When VCC data was purged (retention policy)

  refunds         Refund[]
  gatewayWebhooks GatewayWebhook[]
  paymentSessions PaymentSession[]

  @@index([bookingId])
  @@index([folioId])
  @@index([status])
  @@index([hotelId, status])
  @@index([vccToken])
  @@index([vccPurgedAt])
}

model Refund {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  amount          Float
  reason          String?
  gatewayRefundId String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  @@index([paymentId])
}

// ============================================================
//  جلسات الدفع عبر البوابات المحلية (Local Payment Gateways)
// ============================================================
// PaymentSession يتبع محاولة دفع واحدة في الحجز المباشر: (ضيف → بوابة → دفعة).
// الجلسة لا تمسّ الـ Ledger إطلاقاً — فقط عند تأكيد الـ Webhook ننشئ الـ Payment
// المكتمل ثم نطبقه على الـ Folio عبر applyPayment. الجلسات لا تُحذف أبداً
// (أرشيف تدقيق مرحلة PCI، بنفس روح VCCAuditLog).
model PaymentSession {
  id                   String    @id @default(uuid())
  hotelId              String
  hotel                Hotel     @relation(fields: [hotelId], references: [id])
  bookingId            String
  booking              Booking   @relation(fields: [bookingId], references: [id])
  folioId              String?
  folio                Folio?    @relation(fields: [folioId], references: [id])
  guestId              String?
  guest                Guest?    @relation(fields: [guestId], references: [id])
  method               String // PLUTU | TLYNC | CASH | BANK_TRANSFER
  gateway              String // plutu | tlync | bank_transfer | cash
  amount               Float
  currency             String    @default("LYD")
  status               String    @default("PENDING") // PENDING | SUCCEEDED | FAILED | EXPIRED
  merchantTxId         String? // معرّف المعاملة لدينا (مرسل للبوابة عند الإنشاء)
  gatewayTransactionId String? // أيد البوابة الرسمي (يعود في الـ webhook)
  gatewayReference     String? // رقم المرجع/الفاتورة من البوابة
  signature            String?
  idempotencyKey       String?   @unique
  returnUrl            String?
  paymentId            String?
  payment              Payment?  @relation(fields: [paymentId], references: [id])
  expiresAt            DateTime?
  gatewayConfig        String? // Snapshot of gateway credentials at session creation (prevents config mutation issues)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  gatewayWebhooks GatewayWebhook[]

  @@index([hotelId, status, createdAt])
  @@index([gateway, gatewayTransactionId])
  @@index([bookingId])
}

// ============================================================
//  VCC Audit Log (PCI-DSS compliance tracking)
// ============================================================
model VCCAuditLog {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  paymentId   String?
  bookingId   String?
  action      String // 'tokenized' | 'revealed' | 'purged' | 'charge_attempted' | 'charge_succeeded' | 'charge_failed'
  vccTokenRef String? // Reference to token (not the token itself)
  vgsVaultId  String?
  performedBy String? // User ID or 'system' for automated jobs
  ipAddress   String?
  userAgent   String?
  metadata    String? // JSON with additional context
  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([paymentId])
  @@index([bookingId])
  @@index([action])
}

// ============================================================
//  تكاملات محركات الحجز الخارجية (Decoupled PMS Ledger)
// ============================================================
enum IntegrationKind {
  BOOKING_ENGINE
  PAYMENT_GATEWAY
}

model IntegrationConfig {
  id          String            @id @default(uuid())
  hotelId     String
  hotel       Hotel             @relation(fields: [hotelId], references: [id])
  engine      String
  kind        IntegrationKind   @default(BOOKING_ENGINE)
  apiKeyEnc   String?
  isActive    Boolean           @default(false)
  config      String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([hotelId, engine])
  @@index([hotelId])
  @@index([kind])
}

model GatewayWebhook {
  id          String    @id @default(uuid())
  provider    String
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  eventId     String
  type        String
  payload     String
  status      String    @default("RECEIVED")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  paymentId        String?
  payment          Payment?        @relation(fields: [paymentId], references: [id])
  paymentSessionId String?
  paymentSession   PaymentSession? @relation(fields: [paymentSessionId], references: [id])

  @@unique([provider, hotelId, eventId])
  @@index([hotelId])
  @@index([paymentId])
  @@index([paymentSessionId])
}

// ============================================================
//  مدير القنوات (Channel Manager / OTA) — Sprint 1 addendum
// ============================================================
// Maps each OTA's room-type/rate-plan IDs to the hotel's local RoomType/RatePlan
// so availability/rates can be pushed and bookings mapped inbound.
enum ChannelProvider {
  BOOKING_COM
  EXPEDIA
  AIRBNB
  AGODA
  TRIP
  OTHER
}

model ChannelMapping {
  id                String          @id @default(uuid())
  hotelId           String
  hotel             Hotel           @relation(fields: [hotelId], references: [id])
  provider          ChannelProvider
  channelRoomTypeId String // OTA's room type ID
  channelRatePlanId String? // OTA's rate plan ID
  channelName       String? // human label from OTA
  roomTypeId        String
  roomType          RoomType        @relation(fields: [roomTypeId], references: [id])
  ratePlanId        String?
  ratePlan          RatePlan?       @relation(fields: [ratePlanId], references: [id])
  enabled           Boolean         @default(true)
  lastPushedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([hotelId, roomTypeId, channelRoomTypeId])
  @@index([hotelId, provider])
  @@index([provider, channelRoomTypeId])
}

// Daily price/availability snapshot sent to (or received from) a channel.
// Nativity: one row per roomType per date — a simple high-watermark stream the
// job layer reads to diff and push to the OTA. Kept audit-grade.
model ChannelPriceSnapshot {
  id          String          @id @default(uuid())
  hotelId     String
  hotel       Hotel           @relation(fields: [hotelId], references: [id])
  provider    ChannelProvider
  roomTypeId  String
  roomType    RoomType        @relation(fields: [roomTypeId], references: [id])
  date        DateTime        @db.Date
  available   Int             @default(0)
  nightlyRate Float
  createdAt   DateTime        @default(now())

  @@unique([hotelId, provider, roomTypeId, date])
  @@index([hotelId, provider, date])
}

// ============================================================
//  الفواتير والضرائب
// ============================================================
model Invoice {
  id               String          @id @default(uuid())
  hotelId          String
  hotel            Hotel           @relation(fields: [hotelId], references: [id])
  folioId          String?
  folio            Folio?          @relation(fields: [folioId], references: [id])
  externalClientId String?
  externalClient   ExternalClient? @relation(fields: [externalClientId], references: [id])
  invoiceNo        String          @unique
  // Corporate monthly billing lifecycle (constrained in code: DRAFT | ISSUED | PAID | VOID)
  status           String          @default("ISSUED")
  periodStart      DateTime?
  periodEnd        DateTime?
  dueDate          DateTime?
  paidAt           DateTime?
  subtotal         Decimal         @default(0)
  taxAmount        Decimal         @default(0)
  paidAmount       Decimal         @default(0)
  notes            String?
  items            Json?
  total            Float           @default(0)
  pdfUrl           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([folioId])
  @@index([externalClientId])
  @@index([hotelId, externalClientId])
  @@index([hotelId, status])
}

model TaxRule {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  services Service[]

  @@index([hotelId])
}

// ============================================================
//  الإشعارات والتدقيق
// ============================================================
model Notification {
  id        String    @id @default(uuid())
  hotelId   String
  hotel     Hotel     @relation(fields: [hotelId], references: [id])
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  type      String
  event     String
  recipient String
  subject   String?
  body      String?
  status    String    @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([hotelId, status])
  @@index([bookingId])
}

model AuditLog {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  userId    String?
  bookingId String?
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@index([hotelId, entity, entityId])
  @@index([createdAt])
}

// ============================================================
//  نظام المطعم (Restaurant POS)
// ============================================================
model MenuCategory {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  menuItems MenuItem[]

  @@index([hotelId])
}

model MenuItem {
  id          String       @id @default(uuid())
  hotelId     String
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  nameAr      String?
  description String?
  price       Float
  image       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  orderItems RestaurantOrderItem[]

  @@index([hotelId, categoryId])
}

model RestaurantOrder {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  orderNo     String   @unique
  orderType   String   @default("DINE_IN")
  tableNo     String?
  roomNo      String?
  guestName   String?
  status      String   @default("PENDING")
  notes       String?
  totalAmount Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items RestaurantOrderItem[]

  @@index([hotelId, status, createdAt])
  @@index([bookingId])
}

model RestaurantOrderItem {
  id         String          @id @default(uuid())
  hotelId    String
  hotel      Hotel           @relation(fields: [hotelId], references: [id])
  orderId    String
  order      RestaurantOrder @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity   Int             @default(1)
  price      Float
  notes      String?
  createdAt  DateTime        @default(now())

  @@index([orderId])
}

// Hotel model needs RestaurantOrder + MenuItemCategory + MenuItem
// Already has all relationships via the models above
// ============================================================
//  التدبير المنزلي
// ============================================================
model TaskType {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([hotelId, name])
  @@index([hotelId])
}

model HousekeepingTask {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  taskType    String
  priority    String    @default("NORMAL")
  assignedTo  String?
  notes       String?
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([hotelId, status])
  @@index([roomId])
}

// ============================================================
//  الشركاء الخارجيون (API)
// ============================================================
model ApiPartner {
  id         String    @id @default(uuid())
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id])
  name       String
  apiKey     String    @unique
  apiSecret  String
  allowedIPs String?
  rateLimit  Int       @default(100)
  dailyLimit Int       @default(10000)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  webhookEndpoints WebhookEndpoint[]

  @@index([hotelId])
}

model WebhookEndpoint {
  id            String     @id @default(uuid())
  hotelId       String
  hotel         Hotel      @relation(fields: [hotelId], references: [id])
  partnerId     String
  partner       ApiPartner @relation(fields: [partnerId], references: [id])
  url           String
  events        String
  retryCount    Int        @default(3)
  retryInterval Int        @default(60)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  @@index([partnerId])
}

// ============================================================
//  مفاتيح الـ API الخارجية (Headless API Ecosystem)
// ============================================================
// The ApiKey is the credential for the Headless Booking API.
// - hotelId null  => platform-wide key (SUPER_ADMIN created keys).
// - hotelId set   => scoped to a single hotel.
// Only the SHA-256 hash is stored; the plaintext value is returned
// exactly ONCE at creation/rotation time (hk_<prefix>_<secret>).
model ApiKey {
  id            String      @id @default(uuid())
  label         String
  hotelId       String?
  hotel         Hotel?      @relation(fields: [hotelId], references: [id])
  partnerType   PartnerType @default(B2B_AGENCY)
  prefix        String
  keyHash       String      @unique
  scopes        String[]    @default(["bookings:write"])
  rateLimit     Int         @default(100)
  dailyLimit    Int         @default(10000)
  allowedIPs    String?
  isActive      Boolean     @default(true)
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  lastRotatedAt DateTime?
  createdById   String?
  createdBy     User?       @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([hotelId])
  @@index([prefix])
  @@index([partnerType])
}

// ============================================================
//  صناديق الأمانات (Safe Deposit Box) — Hybrid Operation Mode
// ============================================================
// Polymorphic ownership: links to a Booking (hotel guest) OR
// an ExternalClient (standalone). Exactly one is set at app level.
enum SafeBoxTransactionType {
  DEPOSIT
  WITHDRAWAL
}

// --- Standalone clients (non-hotel guests) ---
model ExternalClient {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  phone     String?
  email     String?
  idNumber  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  safeDepositBoxes SafeDepositBox[]
  invoices         Invoice[]

  @@index([hotelId])
}

// --- Pricing packages ---
model SafeBoxPackage {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  name         String
  dailyPrice   Decimal
  weeklyPrice  Decimal
  monthlyPrice Decimal
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  safeDepositBoxes SafeDepositBox[]

  @@index([hotelId])
}

model SafeDepositBox {
  id               String          @id @default(uuid())
  serialNumber     Int             @unique @default(autoincrement())
  hotelId          String
  hotel            Hotel           @relation(fields: [hotelId], references: [id])
  roomId           String?
  room             Room?           @relation(fields: [roomId], references: [id])
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id])
  externalClientId String?
  externalClient   ExternalClient? @relation(fields: [externalClientId], references: [id])
  packageId        String?
  package          SafeBoxPackage? @relation(fields: [packageId], references: [id])
  rentalFee        Decimal?
  rentalDuration   String?
  expectedEndDate  DateTime?
  status           String          @default("ACTIVE")
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  openedById       String
  openedBy         User            @relation("SafeDepositOpenedBy", fields: [openedById], references: [id])
  closedById       String?
  closedBy         User?           @relation("SafeDepositClosedBy", fields: [closedById], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items        SafeDepositBoxItem[]
  transactions SafeBoxTransaction[]

  @@index([hotelId, status])
  @@index([roomId])
  @@index([externalClientId])
  @@index([packageId])
}

model SafeDepositBoxItem {
  id               String         @id @default(uuid())
  hotelId          String
  hotel            Hotel          @relation(fields: [hotelId], references: [id])
  safeDepositBoxId String
  safeDepositBox   SafeDepositBox @relation(fields: [safeDepositBoxId], references: [id])
  description      String
  quantity         Int            @default(1)
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([safeDepositBoxId])
}

// --- Audit trail for cash/valuables movement ---
model SafeBoxTransaction {
  id               String                 @id @default(uuid())
  hotelId          String
  hotel            Hotel                  @relation(fields: [hotelId], references: [id])
  safeDepositBoxId String
  safeDepositBox   SafeDepositBox         @relation(fields: [safeDepositBoxId], references: [id])
  type             SafeBoxTransactionType
  amount           Int?
  description      String?
  staffId          String
  staff            User                   @relation(fields: [staffId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([safeDepositBoxId])
  @@index([createdAt])
}

// ============================================================
//  المفقودات والمعثورات (Lost & Found)
// ============================================================
model LostItem {
  id                String    @id @default(uuid())
  hotelId           String
  hotel             Hotel     @relation(fields: [hotelId], references: [id])
  roomId            String?
  room              Room?     @relation(fields: [roomId], references: [id])
  description       String
  locationFound     String
  foundById         String
  foundBy           User      @relation("LostItemFoundBy", fields: [foundById], references: [id])
  status            String    @default("PENDING")
  imageUrl          String?
  claimedByName     String?
  claimedByIdNumber String?
  claimedAt         DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([hotelId, status])
  @@index([roomId])
}

// ============================================================
//  إعدادات التقارير (Report Settings)
// ============================================================
model ReportSetting {
  id         String   @id @default(uuid())
  hotelId    String   @unique
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  logoUrl    String?
  headerText String?
  footerText String?
  taxNumber  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
//  إعدادات الحجز عبر الموقع
// ============================================================
model WebsiteSetting {
  id                      String   @id @default(uuid())
  hotelId                 String   @unique
  hotel                   Hotel    @relation(fields: [hotelId], references: [id])
  isOnlineBookingEnabled  Boolean  @default(false)
  taxRate                 Float    @default(0)
  bookingFee              Float    @default(0)
  discountPercent         Float    @default(0)
  confirmationCutoffHours Int      @default(48)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

