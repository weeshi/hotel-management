generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  الفندق — الإعدادات الأساسية
// ============================================================
model Hotel {
  id           String   @id @default(uuid())
  name         String
  nameAr       String?
  address      String?
  phone        String?
  email        String?
  currency     String   @default("LYD")
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("12:00")
  timezone     String   @default("Asia/Tripoli")
  settings     String?
  createdAt    DateTime @default(now())

  rooms                Room[]
  roomTypes            RoomType[]
  ratePlans            RatePlan[]
  cancellationPolicies CancellationPolicy[]
  services             Service[]
  serviceCategories    ServiceCategory[]
  bookings             Booking[]
  users                User[]
  apiPartners          ApiPartner[]
  taxRules             TaxRule[]
  housekeepingTasks    HousekeepingTask[]
  taskTypes            TaskType[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  restaurantOrders     RestaurantOrder[]
  safeDepositBoxes     SafeDepositBox[]
  safeboxPackages      SafeBoxPackage[]
  externalClients      ExternalClient[]
  lostItems            LostItem[]
  reportSetting        ReportSetting?
  groupBookings        GroupBooking[]
}

// ============================================================
//  المستخدمون والصلاحيات
// ============================================================
enum Role {
  ADMIN
  RECEPTION
  MANAGER
  HOUSEKEEPING
  MAINTENANCE
  RESTAURANT
  ACCOUNTANT
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  name                String
  phone               String?
  role                Role           @default(RECEPTION)
  hotelId             String?
  hotel               Hotel?         @relation(fields: [hotelId], references: [id])
  isActive            Boolean        @default(true)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean        @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  refreshTokens       RefreshToken[]
  createdAt           DateTime       @default(now())

  createdTransactions FolioTransaction[]   @relation("TransactionCreatedBy")
  settledFolios       Folio[]              @relation("FolioSettledBy")
  openedSafeDeposits  SafeDepositBox[]     @relation("SafeDepositOpenedBy")
  closedSafeDeposits  SafeDepositBox[]     @relation("SafeDepositClosedBy")
  foundLostItems      LostItem[]           @relation("LostItemFoundBy")
  safeBoxTransactions SafeBoxTransaction[]
  walletTransactions  WalletTransaction[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  expiresAt  DateTime
  family     String
  revoked    Boolean  @default(false)
  replacedBy String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  MOBICASH
  IDFA3LY
  YASERPAY
  ONEPAY
  CASH
  POS
  WALLET
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ============================================================
//  الضيوف
// ============================================================
model Guest {
  id            String   @id @default(uuid())
  name          String
  email         String?  @unique
  phone         String?  @unique
  address       String?
  nationality   String?
  idNumber      String?  @unique
  emailVerified Boolean  @default(false)
  loyaltyPoints Int      @default(0)
  allowCredit   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  bookings Booking[]
  wallets  Wallet[]
}

model Wallet {
  id        String   @id @default(uuid())
  guestId   String
  hotelId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  balance   Decimal  @default(0)
  isFrozen  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@unique([guestId, hotelId])
  @@index([hotelId])
}

model WalletTransaction {
  id             String                @id @default(uuid())
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id])
  type           WalletTransactionType
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  description    String?
  referenceId    String?
  idempotencyKey String?               @unique
  method         PaymentMethod?
  status         TransactionStatus     @default(COMPLETED)
  createdById    String?
  createdBy      User?                 @relation(fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())

  @@index([walletId])
  @@index([createdAt])
}

// ============================================================
//  الغرف وأنواعها
// ============================================================
model RoomType {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  name        String
  nameAr      String?
  description String?
  baseRate    Float
  capacity    Int      @default(2)
  images      String?
  createdAt   DateTime @default(now())

  rooms           Room[]
  ratePlans       RatePlan[]
  extraBeds       RoomTypeExtraBed[]
  defaultServices RoomTypeDefaultService[]
  amenityServices RoomTypeAmenity[]
}

model RoomTypeExtraBed {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  bedType    String
  label      String
  labelAr    String?
  price      Float
  maxCount   Int      @default(1)

  @@index([roomTypeId])
}

model RoomTypeDefaultService {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  isFree     Boolean  @default(true)

  @@unique([roomTypeId, serviceId])
  @@index([roomTypeId])
}

model RoomTypeAmenity {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([roomTypeId, serviceId])
  @@index([roomTypeId])
}

model Room {
  id                 String   @id @default(uuid())
  hotelId            String
  hotel              Hotel    @relation(fields: [hotelId], references: [id])
  roomNumber         String
  floor              Int?
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id])
  status             String   @default("AVAILABLE")
  housekeepingStatus String   @default("CLEAN")
  notes              String?
  createdAt          DateTime @default(now())

  bookingRooms      BookingRoom[]
  housekeepingTasks HousekeepingTask[]
  safeDepositBoxes  SafeDepositBox[]
  lostItems         LostItem[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
}

// ============================================================
//  الأسعار الموسمية (Rate Plans)
// ============================================================
model RatePlan {
  id                   String              @id @default(uuid())
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id])
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id])
  name                 String
  nameAr               String?
  nightlyRate          Float
  startDate            DateTime
  endDate              DateTime
  minStay              Int                 @default(1)
  maxAdults            Int                 @default(2)
  maxChildren          Int                 @default(0)
  extraBedPrice        Float?
  applyDays            String?
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())

  bookingRooms BookingRoom[]

  @@index([hotelId, roomTypeId])
}

model CancellationPolicy {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  rules     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ratePlans RatePlan[]
  bookings  Booking[]

  @@index([hotelId])
}

// ============================================================
//  الحجوزات
// ============================================================
model Booking {
  id                   String              @id @default(uuid())
  bookingNo            String              @unique
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id])
  guestId              String?
  guest                Guest?              @relation(fields: [guestId], references: [id])
  guestName            String?
  guestEmail           String?
  guestPhone           String?
  status               String              @default("PENDING")
  source               String              @default("WEBSITE")
  adults               Int                 @default(1)
  children             Int                 @default(0)
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  cancelledAt          DateTime?
  cancellationReason   String?
  groupBookingId       String?
  groupBooking         GroupBooking?       @relation(fields: [groupBookingId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  rooms            BookingRoom[]
  folio            Folio?
  bookingServices  BookingService[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  restaurantOrders RestaurantOrder[]
  safeDepositBoxes SafeDepositBox[]

  @@index([hotelId, status, createdAt])
  @@index([groupBookingId])
}

model BookingRoom {
  id          String    @id @default(uuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  ratePlanId  String?
  ratePlan    RatePlan? @relation(fields: [ratePlanId], references: [id])
  nightlyRate Float
  checkIn     DateTime
  checkOut    DateTime

  roomCharges RoomCharge[]

  @@index([bookingId])
  @@index([roomId])
}

// ============================================================
//  الخدمات
// ============================================================
model ServiceCategory {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  services Service[]

  @@index([hotelId])
}

model Service {
  id          String          @id @default(uuid())
  hotelId     String
  hotel       Hotel           @relation(fields: [hotelId], references: [id])
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  nameAr      String?
  description String?
  price       Float
  taxRuleId   String?
  taxRule     TaxRule?        @relation(fields: [taxRuleId], references: [id])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  bookingServices   BookingService[]
  roomTypeDefaults  RoomTypeDefaultService[]
  roomTypeAmenities RoomTypeAmenity[]

  @@index([hotelId, categoryId])
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ============================================================
//  الحجوزات الجماعية والمجموعات
// ============================================================
model GroupBooking {
  id            String   @id @default(uuid())
  name          String
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  masterFolioId String?   @unique
  masterFolio   Folio?    @relation("MasterFolio", fields: [masterFolioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings     Booking[]
  routingRules FolioRoutingRule[]

  @@index([hotelId])
}

model FolioRoutingRule {
  id             String       @id @default(uuid())
  groupBookingId String
  groupBooking   GroupBooking @relation(fields: [groupBookingId], references: [id])
  chargeType     String
  targetFolioId  String
  targetFolio    Folio        @relation(fields: [targetFolioId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([groupBookingId, chargeType])
  @@index([groupBookingId])
}

// ============================================================
//  نظام الفوترة (Folio Billing)
// ============================================================
model Folio {
  id           String    @id @default(uuid())
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id])
  status       String    @default("ACTIVE")
  totalCharges Float     @default(0)
  totalPaid    Float     @default(0)
  balance      Float     @default(0)
  settledAt    DateTime?
  settledById  String?
  settledBy    User?     @relation("FolioSettledBy", fields: [settledById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions     FolioTransaction[]
  payments         Payment[]
  invoices         Invoice[]
  discounts        FolioDiscount[]
  scheduledCharges ScheduledCharge[]
  groupBookingMaster  GroupBooking?      @relation("MasterFolio")
  routingRuleTargets  FolioRoutingRule[]

  @@index([bookingId])
  @@index([status])
}

model ScheduledCharge {
  id          String    @id @default(uuid())
  folioId     String
  folio       Folio     @relation(fields: [folioId], references: [id])
  description String
  amount      Float
  chargeDate  DateTime
  processed   Boolean   @default(false)
  processedAt DateTime?

  @@index([folioId, chargeDate])
}

model RoomCharge {
  id              String      @id @default(uuid())
  bookingRoomId   String
  bookingRoom     BookingRoom @relation(fields: [bookingRoomId], references: [id])
  date            DateTime
  amount          Float
  taxAmount       Float       @default(0)
  status          String      @default("PENDING")
  postedToFolioAt DateTime?

  folioTransaction FolioTransaction?

  @@index([bookingRoomId, date])
}

model FolioTransaction {
  id            String      @id @default(uuid())
  folioId       String
  folio         Folio       @relation(fields: [folioId], references: [id])
  type          String
  category      String
  description   String
  amount        Float
  taxAmount     Float       @default(0)
  taxableAmount Float       @default(0)
  isPartial     Boolean     @default(false)
  referenceId   String?
  roomChargeId  String?     @unique
  roomCharge    RoomCharge? @relation(fields: [roomChargeId], references: [id])
  createdById   String?
  createdBy     User?       @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([folioId])
  @@index([createdAt])
}

model FolioDiscount {
  id          String   @id @default(uuid())
  folioId     String
  folio       Folio    @relation(fields: [folioId], references: [id])
  type        String
  value       Float
  amount      Float
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([folioId])
}

// ============================================================
//  المدفوعات
// ============================================================
model Payment {
  id               String   @id @default(uuid())
  bookingId        String?
  booking          Booking? @relation(fields: [bookingId], references: [id])
  folioId          String?
  folio            Folio?   @relation(fields: [folioId], references: [id])
  amount           Float
  currency         String   @default("LYD")
  method           String
  gateway          String?
  gatewayPaymentId String?
  gatewayIntentId  String?
  idempotencyKey   String?  @unique
  metadata         String?
  refundedAmount   Float    @default(0)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  refunds Refund[]

  @@index([bookingId])
  @@index([folioId])
  @@index([status])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  amount          Float
  reason          String?
  gatewayRefundId String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  @@index([paymentId])
}

// ============================================================
//  الفواتير والضرائب
// ============================================================
model Invoice {
  id               String          @id @default(uuid())
  folioId          String?
  folio            Folio?          @relation(fields: [folioId], references: [id])
  externalClientId String?
  externalClient   ExternalClient? @relation(fields: [externalClientId], references: [id])
  invoiceNo        String          @unique
  total            Float           @default(0)
  pdfUrl           String?
  createdAt        DateTime        @default(now())

  @@index([folioId])
  @@index([externalClientId])
}

model TaxRule {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  services Service[]

  @@index([hotelId])
}

// ============================================================
//  الإشعارات والتدقيق
// ============================================================
model Notification {
  id        String    @id @default(uuid())
  hotelId   String
  hotel     Hotel     @relation(fields: [hotelId], references: [id])
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  type      String
  event     String
  recipient String
  subject   String?
  body      String?
  status    String    @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([hotelId, status])
  @@index([bookingId])
}

model AuditLog {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  userId    String?
  bookingId String?
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@index([hotelId, entity, entityId])
  @@index([createdAt])
}

// ============================================================
//  نظام المطعم (Restaurant POS)
// ============================================================
model MenuCategory {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  menuItems MenuItem[]

  @@index([hotelId])
}

model MenuItem {
  id          String       @id @default(uuid())
  hotelId     String
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  nameAr      String?
  description String?
  price       Float
  image       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  orderItems RestaurantOrderItem[]

  @@index([hotelId, categoryId])
}

model RestaurantOrder {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  orderNo     String   @unique
  orderType   String   @default("DINE_IN")
  tableNo     String?
  roomNo      String?
  guestName   String?
  status      String   @default("PENDING")
  notes       String?
  totalAmount Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items RestaurantOrderItem[]

  @@index([hotelId, status, createdAt])
  @@index([bookingId])
}

model RestaurantOrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      RestaurantOrder @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity   Int             @default(1)
  price      Float
  notes      String?
  createdAt  DateTime        @default(now())

  @@index([orderId])
}

// Hotel model needs RestaurantOrder + MenuItemCategory + MenuItem
// Already has all relationships via the models above
// ============================================================
//  التدبير المنزلي
// ============================================================
model TaskType {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  nameAr    String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([hotelId, name])
  @@index([hotelId])
}

model HousekeepingTask {
  id          String    @id @default(uuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  taskType    String
  priority    String    @default("NORMAL")
  assignedTo  String?
  notes       String?
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([hotelId, status])
  @@index([roomId])
}

// ============================================================
//  الشركاء الخارجيون (API)
// ============================================================
model ApiPartner {
  id         String    @id @default(uuid())
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id])
  name       String
  apiKey     String    @unique
  apiSecret  String
  allowedIPs String?
  rateLimit  Int       @default(100)
  dailyLimit Int       @default(10000)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  webhookEndpoints WebhookEndpoint[]

  @@index([hotelId])
}

model WebhookEndpoint {
  id            String     @id @default(uuid())
  partnerId     String
  partner       ApiPartner @relation(fields: [partnerId], references: [id])
  url           String
  events        String
  retryCount    Int        @default(3)
  retryInterval Int        @default(60)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  @@index([partnerId])
}

// ============================================================
//  صناديق الأمانات (Safe Deposit Box) — Hybrid Operation Mode
// ============================================================
// Polymorphic ownership: links to a Booking (hotel guest) OR
// an ExternalClient (standalone). Exactly one is set at app level.
enum SafeBoxTransactionType {
  DEPOSIT
  WITHDRAWAL
}

// --- Standalone clients (non-hotel guests) ---
model ExternalClient {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  phone     String?
  email     String?
  idNumber  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  safeDepositBoxes SafeDepositBox[]
  invoices         Invoice[]

  @@index([hotelId])
}

// --- Pricing packages ---
model SafeBoxPackage {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  dailyPrice   Decimal
  weeklyPrice  Decimal
  monthlyPrice Decimal
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  safeDepositBoxes SafeDepositBox[]

  @@index([hotelId])
}

model SafeDepositBox {
  id               String          @id @default(uuid())
  serialNumber     Int             @unique @default(autoincrement())
  hotelId          String
  hotel            Hotel           @relation(fields: [hotelId], references: [id])
  roomId           String?
  room             Room?           @relation(fields: [roomId], references: [id])
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id])
  externalClientId String?
  externalClient   ExternalClient? @relation(fields: [externalClientId], references: [id])
  packageId        String?
  package          SafeBoxPackage? @relation(fields: [packageId], references: [id])
  rentalFee        Decimal?
  rentalDuration   String?
  expectedEndDate  DateTime?
  status           String          @default("ACTIVE")
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  openedById       String
  openedBy         User            @relation("SafeDepositOpenedBy", fields: [openedById], references: [id])
  closedById       String?
  closedBy         User?           @relation("SafeDepositClosedBy", fields: [closedById], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items        SafeDepositBoxItem[]
  transactions SafeBoxTransaction[]

  @@index([hotelId, status])
  @@index([roomId])
  @@index([externalClientId])
  @@index([packageId])
}

model SafeDepositBoxItem {
  id               String         @id @default(uuid())
  safeDepositBoxId String
  safeDepositBox   SafeDepositBox @relation(fields: [safeDepositBoxId], references: [id])
  description      String
  quantity         Int            @default(1)
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([safeDepositBoxId])
}

// --- Audit trail for cash/valuables movement ---
model SafeBoxTransaction {
  id               String                 @id @default(uuid())
  safeDepositBoxId String
  safeDepositBox   SafeDepositBox         @relation(fields: [safeDepositBoxId], references: [id])
  type             SafeBoxTransactionType
  amount           Int?
  description      String?
  staffId          String
  staff            User                   @relation(fields: [staffId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([safeDepositBoxId])
  @@index([createdAt])
}

// ============================================================
//  المفقودات والمعثورات (Lost & Found)
// ============================================================
model LostItem {
  id                String    @id @default(uuid())
  hotelId           String
  hotel             Hotel     @relation(fields: [hotelId], references: [id])
  roomId            String?
  room              Room?     @relation(fields: [roomId], references: [id])
  description       String
  locationFound     String
  foundById         String
  foundBy           User      @relation("LostItemFoundBy", fields: [foundById], references: [id])
  status            String    @default("PENDING")
  imageUrl          String?
  claimedByName     String?
  claimedByIdNumber String?
  claimedAt         DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([hotelId, status])
  @@index([roomId])
}

// ============================================================
//  إعدادات التقارير (Report Settings)
// ============================================================
model ReportSetting {
  id         String   @id @default(uuid())
  hotelId    String   @unique
  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  logoUrl    String?
  headerText String?
  footerText String?
  taxNumber  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
